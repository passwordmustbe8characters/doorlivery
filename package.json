{
  "name": "doorlivery",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @doorlivery/api",
    "dev:web": "npm run dev -w @doorlivery/web",
    "build": "npm run build -w @doorlivery/web",
    "start": "npm run start -w @doorlivery/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @doorlivery/api",
    "db:migrate": "npm run db:migrate -w @doorlivery/api",
    "db:seed": "npm run db:seed -w @doorlivery/api",
    "retention": "npm run retention -w @doorlivery/api --",
    "test": "npm run test --workspaces --if-present",
    "probe:nipost": "tsx scripts/probe-nipost.ts",
    "vendor:create": "tsx scripts/create-vendor.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.0"
    }
  }
}
