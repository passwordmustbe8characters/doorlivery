# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (managed Postgres, e.g. Render / Neon / Supabase)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# NIPOST postcode API (server-side only, never expose to the browser)
NIPOST_API_BASE_URL=https://api.postcode.gov.ng
NIPOST_API_KEY=your-nipost-api-key-here

# Required for delivery codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it stable: changing it invalidates codes already issued.
DELIVERY_CODE_SECRET=generate-a-random-secret

# Optional. Defaults shown.
# NIPOST_TIMEOUT_MS=5000
# NIPOST_REVERSE_RADIUS_M=50
# NIPOST_FAR_DISTANCE_M=30
# PUBLIC_BASE_URL=http://localhost:4000
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# SESSION_IDLE_HOURS=72
# SESSION_ABSOLUTE_DAYS=30
# EXTRA_ALLOWED_ORIGINS=
# TOKEN_TTL_AFTER_CLOSE_DAYS=7
# RETENTION_DAYS=90
# RETENTION_JOB_ENABLED=true   (default: on in production, off in development)
